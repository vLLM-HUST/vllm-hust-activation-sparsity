+    "active_density_max",
+    "active_density_mean",
+    "active_sparsity_mean",
+    "active_stats_error",
+)
+
+
+def marker_record_sequence(
+    records: list[dict[str, Any]],
+    limit: int,
+) -> list[dict[str, Any]]:
+    if limit <= 0:
+        return []
+    sequence = []
+    for record in records[:limit]:
+        sequence.append(
+            {key: record[key] for key in MARKER_SEQUENCE_KEYS if key in record}
+        )
+    return sequence
+
