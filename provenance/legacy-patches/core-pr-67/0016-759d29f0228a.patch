+        x=x,
+        threshold=threshold,
+        inclusive=True,
+        weight_t=weight_t,
+        op_name="activation_sparse_topk_matmul_silu",
+    )
+
+    selected_indices = topk_indices[0].to(dtype=torch.long).contiguous()
+    selected_x = x[:, selected_indices].contiguous()
