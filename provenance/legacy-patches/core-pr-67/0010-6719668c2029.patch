+def unique_marker_values(
+    records: list[dict[str, Any]],
+    key: str,
+) -> list[Any]:
+    values: list[Any] = []
+    seen: set[str] = set()
+    for record in records:
+        if key not in record:
+            continue
+        value = record[key]
+        marker = json.dumps(value, sort_keys=True)
+        if marker in seen:
+            continue
+        seen.add(marker)
+        values.append(value)
+    return values
+
